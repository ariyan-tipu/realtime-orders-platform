# Copy to `.env` before running `docker compose up`.
#
# This file configures LOCAL DEVELOPMENT. The service itself defaults to the
# restrictive setting for everything below, so an environment that was never
# configured fails closed: debug off, no secret key (it refuses to boot), and
# no anonymous writes. The values here deliberately open all three up,
# because that is what makes the one-command demo work on your machine.
#
# For a real deployment, see the "Production values" block at the bottom.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=dev-only-password

# Hostnames as seen from inside the Compose network. When running services
# directly on your machine against the Compose database, use DB_HOST=localhost.
DB_HOST=db
DB_PORT=5432

# --- Redis (Django cache for hot analytics queries) ------------------------
REDIS_URL=redis://redis:6379/0

# --- Django core service ----------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core,proxy
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opens the public write surface: anonymous order placement plus the
# /api/demo/* traffic generator behind the dashboard's "Simulate order"
# button. Order lifecycle transitions (advance, cancel) are NOT covered by
# this and always require an authenticated user, because cancelling returns
# units to stock and order ids are readable from the list endpoint.
DEMO_MODE=1
# Used by `manage.py seed_data` to create the admin account.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin-dev-only

# --- FastAPI realtime service -----------------------------------------------
# Must point at the same database the core service writes to; NOTIFY events
# are only visible on the emitting database.
RT_DATABASE_URL=postgresql://orders:dev-only-password@db:5432/orders
RT_LOG_LEVEL=info

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8001

# --- Production values --------------------------------------------------------
# Do not copy the development block above onto a server. A deployment wants:
#
#   DJANGO_SECRET_KEY=<64 random bytes, never this file's value>
#   DJANGO_DEBUG=0                       # or omit it; off is the default
#   DJANGO_ALLOWED_HOSTS=your.domain
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain
#   CORS_ALLOWED_ORIGINS=https://your.domain
#   DEMO_MODE=0                          # or omit it; closed is the default
#   DJANGO_BEHIND_TLS=1                  # ONLY once TLS is actually in front
#   POSTGRES_PASSWORD=<generated>
#   DJANGO_SUPERUSER_PASSWORD=<generated>
#
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# With DJANGO_DEBUG off the service always sends nosniff, X-Frame-Options
# DENY and a same-origin referrer policy. DJANGO_BEHIND_TLS additionally
# turns on the HTTPS redirect, HSTS and secure-only session and CSRF
# cookies. Those are gated separately on purpose: set on a host with no
# HTTPS listener they send every request into a redirect loop out of the
# stack, and the secure cookies stop anyone logging into the admin. The
# bundled deploy/nginx.conf listens on port 80 only, so turn this on in the
# same step that installs a certificate, not before.
#
# CI runs `manage.py check --deploy --fail-level WARNING` with
# DJANGO_BEHIND_TLS on, so the internet-facing posture is verified on every
# push rather than described.
